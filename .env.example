DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
APP_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
AUTH_SECRET=""
SENTRY_DSN=""
# Browser error monitoring. A Sentry DSN is public; never place a Sentry auth token here.
NEXT_PUBLIC_SENTRY_DSN=""
# Required in production. Allow only the public web application's origin for Socket.IO.
REALTIME_ALLOWED_ORIGIN="http://localhost:3000"
# Use `local` only for development. Production requires the S3-compatible values below.
FILE_STORAGE_PROVIDER="local"
FILE_STORAGE_BUCKET=""
FILE_STORAGE_REGION=""
FILE_STORAGE_ENDPOINT=""
FILE_STORAGE_FORCE_PATH_STYLE="false"
FILE_STORAGE_ACCESS_KEY_ID=""
FILE_STORAGE_SECRET_ACCESS_KEY=""
# Required only to create the first administrator in a new database.
ADMIN_BOOTSTRAP_USERNAME=""
ADMIN_BOOTSTRAP_PASSWORD=""
# Phone OTP provider. Keep "development" until Twilio Verify is configured; set to "twilio" to send real SMS.
PHONE_OTP_PROVIDER="development"
# Development/Preview only. Never expose this value to the browser.
DEV_PHONE_OTP="2412"
# Twilio Verify credentials. Server-only; never prefix with NEXT_PUBLIC_.
# Account SID/Auth Token from Console > Account > Account Info (Account SID must start with "AC").
# Verify Service SID from Console > Verify > Services (starts with "VA"); set its code length to 4.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
# Reserved for a future SMS provider. Do not use NEXT_PUBLIC_ prefixes for these secrets.
SMS_API_KEY=""
SMS_API_SECRET=""
SMS_SENDER_ID=""
SMS_API_URL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Server key for address geocoding. Restrict this key by server IP in production.
GOOGLE_MAPS_SERVER_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_JS_ENABLED="true"
PERSONA_ENABLED="false"
PERSONA_API_KEY=""
PERSONA_TEMPLATE_ID=""
PERSONA_WEBHOOK_SECRET=""
# Use Test Mode credentials locally. The key ID must begin with rzp_test_.
RAZORPAY_ENABLED="true"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Configure this same secret in Razorpay Dashboard > Webhooks.
RAZORPAY_WEBHOOK_SECRET=""
# Keep false until Razorpay Route Linked Accounts and payout permissions are approved.
RAZORPAY_ROUTE_ENABLED="false"
